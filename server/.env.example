# ==========================================
# Server Environment Variables
# ==========================================

# Port the server runs on
PORT=4000

# VERY IMPORTANT: Change this to a long, random string in production!
# e.g. using `openssl rand -hex 32`
JWT_SECRET=super_secret_dev_key_replace_me_in_prod

# The URL of the frontend application (for CORS)
# In dev: http://localhost:5173
# In prod: https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173

# ==========================================
# Cloud Database (Turso) Configuration
# ==========================================
# Leave these empty in local development to automatically fall back to local.db (SQLite file).
# Fill these in production (e.g. Vercel environment variables).
TURSO_DATABASE_URL=libsql://your-db-name-username.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here
