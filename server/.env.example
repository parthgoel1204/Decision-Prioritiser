# ==========================================
# Server Environment Variables
# ==========================================

# Port the server runs on
PORT=4000

# VERY IMPORTANT: Change this to a long, random string in production!
# e.g. using `openssl rand -hex 32`
JWT_SECRET=super_secret_dev_key_replace_me_in_prod

# The URL of the frontend application (for CORS)
# In dev: http://localhost:5173
# In prod: https://your-frontend-domain.com
CLIENT_URL=http://localhost:5173

# Database path (optional, defaults to ./data.db)
# DB_PATH=./data.db
